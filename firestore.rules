rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // TODO: Add isAdmin check once we have custom claims or an admin list
    // function isAdmin() {
    //   return request.auth.token.email == 'admin@sceneme.com'; 
    // }

    // Users collection: Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Orders collection: 
    // - Anyone can create an order (public checkout)
    // - Only owner or admin can read/update (for now, authenticated users can read their own)
    match /orders/{orderId} {
      allow create: if true; // Public checkout needs to create orders
      allow read: if isAuthenticated(); // Ideally restrict to owner/admin
      allow update: if isAuthenticated(); // Admin updates status
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Permitir acceso si el usuario es el administrador verificado vía contraseña maestra (UID fijo)
      // o si su email coincide con el administrador configurado.
      return request.auth != null && (
        request.auth.uid == 'admin-dashboard' || 
        request.auth.token.email == 'chris.7sanchez@gmail.com'
      );
    }

    // Users collection: Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);

      // Antigravity data: only the user can access their own state
      match /antigravity/{docId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }

    // Orders collection: 
    // - Anyone can create an order (public checkout)
    // - Only admin can read/update/delete.
    match /orders/{orderId} {
      allow create: if true; 
      allow read, update, delete: if isAdmin();
    }
  }
}

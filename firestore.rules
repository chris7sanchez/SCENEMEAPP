rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Permitir acceso si el usuario es el administrador verificado vía contraseña maestra (UID fijo)
      // o si su email coincide con el administrador configurado.
      return request.auth != null && (
        request.auth.uid == 'admin-dashboard' || 
        request.auth.token.email == 'chris.7sanchez@gmail.com'
      );
    }

    // Users collection: Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);

      // TODAS las subcolecciones del usuario (antigravity, submissions del
      // Studio, y las que vengan) — solo su dueño.
      match /{document=**} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }

    // Escena del día del Studio: contenido compartido. Cualquiera la lee;
    // el primer usuario autenticado del día la cachea (setDoc en studio-db).
    //
    // SEGURIDAD (18/10/2026): sólo se puede CREAR (no reescribir ni borrar) y con
    // la forma exacta que guarda studio-db. Antes cualquiera con sesión podía
    // cambiar la escena que ven todos los demás ese día.
    match /dailyScenes/{dateKey} {
      allow read: if true;
      allow create: if isAuthenticated()
        && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['scene', 'createdAt'])
        && request.resource.data.createdAt is number
        && request.resource.data.scene.keys().hasOnly(['title', 'synopsis', 'characters', 'lines'])
        && request.resource.data.scene.title is string && request.resource.data.scene.title.size() <= 300
        && request.resource.data.scene.synopsis is string && request.resource.data.scene.synopsis.size() <= 3000
        && request.resource.data.scene.characters is list && request.resource.data.scene.characters.size() <= 20
        && request.resource.data.scene.lines is list && request.resource.data.scene.lines.size() <= 200;
    }

    // LA SALA DE VISIONADO. Aquí sólo llega lo que el actor decide enseñar:
    // las tomas siguen privadas en users/{uid}/submissions y publicar crea una
    // copia AQUÍ. Se lee con sesión iniciada — nunca en abierto, que son
    // self-tapes de gente real y no material para un buscador.
    match /comunidad/{postId} {
      allow read: if isAuthenticated();
      // Publicar sólo en tu nombre: nadie puede colgar algo firmado por otro.
      // Nace con 0 bravos y apuntando a un vídeo de nuestro propio Storage.
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid
        && request.resource.data.bravos == 0
        && request.resource.data.downloadURL is string
        && request.resource.data.downloadURL.matches('https://firebasestorage[.]googleapis[.]com/.*');
      // Retirar: su dueño o el admin.
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      // Cualquiera con sesión (también el dueño) puede mover el contador de
      // bravos, y NADA más: de uno en uno y sólo a la vez que pone o quita SU
      // bravo (la transacción de comunidad-db). Antes se podía poner cualquier
      // número, y el dueño podía reescribir el documento entero.
      allow update: if isAdmin() || (isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bravos'])
        && (
          (request.resource.data.bravos == resource.data.bravos + 1
            && !exists(/databases/$(database)/documents/comunidad/$(postId)/bravos/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/comunidad/$(postId)/bravos/$(request.auth.uid)))
          || (request.resource.data.bravos == resource.data.bravos - 1
            && exists(/databases/$(database)/documents/comunidad/$(postId)/bravos/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/comunidad/$(postId)/bravos/$(request.auth.uid)))
          || request.resource.data.bravos == resource.data.bravos
        ));

      // Un bravo por persona: el id del documento ES su uid, así que el propio
      // camino impide aplaudir dos veces o aplaudir en nombre de otro.
      match /bravos/{votanteId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && votanteId == request.auth.uid;
      }

      match /comentarios/{comentarioId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid
          && request.resource.data.texto is string && request.resource.data.texto.size() <= 1200;
        // Borra quien lo escribió, el dueño del vídeo (es su espacio) o el admin.
        allow delete: if isAuthenticated() && (
          resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/comunidad/$(postId)).data.uid == request.auth.uid
          || isAdmin()
        );
      }
    }

    // Denuncias: se escriben pero no se leen. Quien denuncia no puede ver lo
    // denunciado por otros, y el denunciado no se entera. Sólo el admin lee.
    match /reportes/{reporteId} {
      allow create: if isAuthenticated() && request.resource.data.denunciante == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // Pedidos del creador de escenas:
    // - Los crea quien ha iniciado sesión, en SU nombre (createOrder en lib/db
    //   ya exige sesión). Antes `if true`: cualquiera, sin cuenta, podía llenar
    //   la colección de pedidos falsos.
    // - Sólo el admin los lee, cambia o borra.
    match /orders/{orderId} {
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'deposit_paid'
        && request.resource.data.totalAmount is number
        && request.resource.data.keys().size() <= 60;
      allow read, update, delete: if isAdmin();
    }
  }
}

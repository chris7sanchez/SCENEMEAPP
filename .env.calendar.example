# ... (tus otras variables de entorno)

# Google Calendar Integration
# 1. El email de la cuenta de servicio (service account) que creaste en Google Cloud
GOOGLE_SERVICE_ACCOUNT_EMAIL="tu-service-account@tu-proyecto.iam.gserviceaccount.com"

# 2. La clave privada completa (incluyendo ---BEGIN PRIVATE KEY--- y saltos de línea)
# Ponla entre comillas dobles.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nContenidoDeTuClave...\n-----END PRIVATE KEY-----\n"

# 3. (Opcional) Tu calendario específico. Si usas tu personal, pon tu email.
# Si compartes el calendario con la Service Account, pon "primary" o tu email.
GOOGLE_CALENDAR_ID="primary"

# Secreto para firmar los enlaces Aceptar/Rechazar de reservas (genera uno con: openssl rand -hex 24)
BOOKING_SECRET="cambiame"

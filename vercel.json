{
    "version": 2,
    "framework": "nextjs",
    "buildCommand": "next build",
    "installCommand": "npm install",
    "regions": [
        "cdg1"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "images": {
        "sizes": [
            256,
            384,
            640,
            750,
            828,
            1080,
            1200,
            1920,
            2048,
            3840
        ],
        "domains": [
            "placehold.co",
            "images.unsplash.com",
            "picsum.photos"
        ],
        "minimumCacheTTL": 60,
        "formats": [
            "image/avif",
            "image/webp"
        ]
    }
}